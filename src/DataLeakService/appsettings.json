{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SensitiveDataPolicy": {
    "DefaultAction": "Block",
    "Rules": [
      {
        "DataType": "CPF",
        "Action": "Block"
      },
      {
        "DataType": "CNPJ",
        "Action": "Block"
      },
      {
        "DataType": "EMAIL",
        "Action": "Block"
      },
      {
        "DataType": "PHONE",
        "Action": "Block"
      },
      {
        "DataType": "RG",
        "Action": "Block"
      },
      {
        "DataType": "CREDIT_CARD",
        "Action": "Block"
      },
      {
        "DataType": "API_KEY",
        "Action": "Block"
      }
    ]
  }
}
